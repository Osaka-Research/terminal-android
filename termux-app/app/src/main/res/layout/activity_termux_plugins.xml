<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/plugins_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/plugins_dashboard_subtitle"
            android:textSize="14sp" />

        <!-- Plugin rows are added programmatically in TermuxPluginsActivity, one per
             installed plugin module, so this list never goes stale relative to what's
             actually merged into the app. -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_backup_section_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_backup_section_description"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/plugins_button_export_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_backup_export" />

            <Button
                android:id="@+id/plugins_button_import_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_backup_import" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/updates_section_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/updates_section_description"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/updates_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/updates_url_hint"
            android:inputType="textUri"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/updates_auto_check_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/updates_auto_check_label" />

        <TextView
            android:id="@+id/updates_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:textStyle="italic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/updates_button_check_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/updates_action_check_now" />

            <Button
                android:id="@+id/updates_button_install"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/updates_action_install"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/x11_section_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/x11_section_description"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/x11_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:textStyle="italic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/x11_button_install_native"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/x11_action_install_native" />

            <Button
                android:id="@+id/x11_button_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/x11_action_start" />

            <Button
                android:id="@+id/x11_button_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/x11_action_stop" />

            <Button
                android:id="@+id/x11_button_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/x11_action_open" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
